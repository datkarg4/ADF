{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"name": "source2"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "split1"
				},
				{
					"name": "union1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "assert1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "flowlet1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     inferDriftedColumnTypes: true,",
				"     limit: 100,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> source2",
				"source1, source2 join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 split(ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     disjoint: false) ~> split1@(, , , , , )",
				"split1, split1, split1, split1, split1, split1 union(byName: true)~> union1",
				"union1, source1 exists(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1, source1 lookup(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(temp = ERROR_FUNCTION('')) ~> derivedColumn1",
				"derivedColumn1 filter(ERROR_FUNCTION('1=1')) ~> filter1",
				"filter1 sort(asc(temp, true),",
				"     partitionLevel: true) ~> sort1",
				"sort1 assert(expectTrue(ERROR_FUNCTION(''), false, 'assert1')) ~> assert1",
				"assert1 alterRow() ~> alterRow1",
				"alterRow1 compose(composition: 'undefined') ~> flowlet1@()"
			]
		}
	}
}